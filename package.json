{
  "name": "if-thursday",
  "version": "1.0.4",
  "description": "Returns true only if today is Thursday.",
  "keywords": [
    "week",
    "calendar",
    "date",
    "day",
    "days",
    "today",
    "thursday"
  ],
  "homepage": "https://github.com/vanodevium/if-thursday",
  "bugs": "https://github.com/vanodevium/if-thursday/issues",
  "repository": "https://github.com/vanodevium/if-thursday",
  "license": "MIT",
  "author": {
    "name": "Vano Devium",
    "email": "vano@devium.me",
    "url": "https://devium.me"
  },
  "exports": {
    ".": {
      "import": "./if-thursday.js",
      "require": "./if-thursday.cjs.js",
      "default": "./if-thursday.cjs.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./if-thursday.cjs.js",
  "module": "./if-thursday.js",
  "files": [
    "if-thursday.cjs.js",
    "if-thursday.js"
  ],
  "scripts": {
    "build": "rolldown -c rolldown.config.js",
    "fix": "biome check --write",
    "test": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.1.0",
    "rolldown": "1.2.16",
    "vitest": "5.1.0"
  }
}